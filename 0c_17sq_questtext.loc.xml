	<string key="Quest_42001_Task_2_Description" rel_version="Territory_Dunwood">Find 50 Memory Fragments</string>
	<string key="Quest_42001_description" rel_version="Territory_Dunwood" speaker="UI - Quest Description">Eliza has asked me to continue to collect more of the soul fragments. As before, she cannot specifiy where they all are, only that they are spread throughout Nighthaven.</string>
